<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.DealerController"
      stylesheets="@/view/style.css"
      prefWidth="540.0" alignment="CENTER">
      <HBox alignment="CENTER">
            <Button onAction="#handleShowMain" styleClass="deck">
                  <graphic>
                        <ImageView>
                              <image>
                                    <Image url="@image/deck.png"/>
                              </image>
                        </ImageView>
                  </graphic>
            </Button>
            <Button onAction="#handleShowSecondary" styleClass="deck">
                  <graphic>
                        <ImageView>
                              <image>
                                    <Image url="@image/deck.png"/>
                              </image>
                        </ImageView>
                  </graphic>
            </Button>
      </HBox>
      <Separator styleClass="padding-small"/>
      <HBox alignment="CENTER" spacing="40">
            <GridPane hgap="30" vgap="20">
                  <Text text="Player 1" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="txt"/>
                  <Text fx:id="p1HealthTxt" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="b-txt"/>
                  <Text text="Player 3" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="txt"/>
                  <Text fx:id="p3HealthTxt" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="b-txt"/>
                  <Text text="Player 2" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="txt"/>
                  <Text fx:id="p2HealthTxt" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="b-txt"/>
                  <Text text="Player 4" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="txt"/>
                  <Text fx:id="p4HealthTxt" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="b-txt"/>
            </GridPane>
            <Button text="Call" onAction="#handleCall" prefWidth="200" prefHeight="50"/>
      </HBox>
      <Separator styleClass="padding-small"/>
      <HBox maxWidth="Infinity">
            <Button prefWidth="180.0" text="Deal" onAction="#handleDeal"/>
            <Button prefWidth="180.0" text="Play Round" onAction="#handlePlayRound"/>
            <Button prefWidth="180.0" text="Exit" onAction="#handleExit"/>
      </HBox>
</VBox>

